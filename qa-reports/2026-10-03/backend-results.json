  "controls": [
    {
      "test": "Main admin API blocks printing unpaid request",
      "expected": 400,
      "actual": 400
    },
    {
      "test": "Main admin API blocks reversing Claimed to Processing",
      "expected": 400,
      "actual": 400
    },
    {
      "test": "Main admin role middleware rejects Collector for captain operation",
      "expected": 403,
      "actual": 403
    },
    {
      "test": "Main resident middleware rejects missing bearer token",
      "expected": 401,
      "actual": 401
    }
  ]
